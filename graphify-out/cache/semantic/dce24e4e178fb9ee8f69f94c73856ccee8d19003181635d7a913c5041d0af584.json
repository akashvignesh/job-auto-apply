{"nodes": [{"id": "server_architecture_md", "label": "MCP Server Architecture Document", "file_type": "document", "source_file": "server/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arch_mcp_server", "label": "MCP Server (Transport & Session Layer)", "file_type": "rationale", "source_file": "server/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MCP server is strictly a transport/session layer \u2014 it must NOT run its own browser-agent LLM loop or define a second copy of browser tools. It exposes 5 tools: browser_start, browser_message, browser_status, browser_stop, browser_screenshot. Concurrency and timeout enforcement happen here."}, {"id": "arch_relay_server", "label": "WebSocket Relay Server", "file_type": "rationale", "source_file": "server/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes tagged task traffic back to originating MCP/CLI client. Queues messages briefly when extension service worker sleeps. Untagged messages still broadcast to all consumers \u2014 a known gap."}, {"id": "arch_extension_bridge", "label": "Extension MCP Bridge (mcp-bridge.js)", "file_type": "rationale", "source_file": "server/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "arch_service_worker", "label": "Chrome Extension Service Worker", "file_type": "rationale", "source_file": "server/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The extension service worker is the source of truth for browser execution. It owns MCP task state, creates isolated browser windows per task, runs the real browser agent, manages follow-up messages, task cancellation, screenshots, and cleanup."}, {"id": "arch_native_host", "label": "Native Host IPC (Legacy Transport)", "file_type": "rationale", "source_file": "server/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy transport that still exists alongside the relay path. Marked as cleanup target \u2014 not the target design."}, {"id": "arch_mcp_tools", "label": "MCP Browser Tools (browser_start/message/status/stop/screenshot)", "file_type": "rationale", "source_file": "server/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "arch_mcp_server", "target": "arch_relay_server", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "arch_relay_server", "target": "arch_extension_bridge", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "arch_extension_bridge", "target": "arch_service_worker", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "arch_mcp_server", "target": "arch_mcp_tools", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "arch_mcp_server", "target": "arch_native_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "server_architecture_md", "target": "arch_mcp_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/ARCHITECTURE.md", "source_location": null, "weight