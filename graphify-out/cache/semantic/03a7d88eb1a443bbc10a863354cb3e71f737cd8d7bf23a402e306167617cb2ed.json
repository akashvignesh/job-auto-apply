{"nodes": [{"id": "domain_skills_json", "label": "Domain Skills Registry", "file_type": "code", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain-specific skills are stored as a JSON registry keyed by domain, injected into the agent system prompt at runtime to prevent known ATS/site interaction mistakes. Each entry encodes verified patterns (e.g., Workday typeahead fields require clicking a dropdown ref, not pressing Enter) learned from real automation runs."}, {"id": "domain_skill_gmail", "label": "Gmail Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_gdocs", "label": "Google Docs Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_gsheets", "label": "Google Sheets Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_github", "label": "GitHub Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_simplifyjobs", "label": "SimplifyJobs GitHub Aggregator Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Specialized skill for SimplifyJobs README job aggregator repos on GitHub. Critical distinctions: click Apply links by accessibility-tree ref (not screen coordinates), skip rows with locked emoji, call tabs_context immediately after clicking Apply to avoid duplicate ATS tabs, and ignore third-party extension overlays (jobright-helper-plugin, simplify-helper)."}, {"id": "domain_skill_reddit", "label": "Reddit Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_jobright", "label": "JobRight.ai Aggregator Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified pattern for avoiding click loops: click Apply with Autofill once, immediately call tabs_context to detect new tab, switch to ATS tab. Includes guidance to dismiss 'Did you apply?' modal on return. Warns against 80K max_chars reads that inflate cost."}, {"id": "domain_skill_icims", "label": "iCIMS ATS Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resume upload is inside shadow DOM \u2014 must use file_upload tool with numeric ref, not OS dialog. Check PortalProfileFields.Resume_FileName hidden input to confirm upload success rather than re-uploading. Dropdowns use full label text (e.g., 'Asian (Not Hispanic or Latino)')."}, {"id": "domain_skill_linkedin", "label": "LinkedIn Easy Apply Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_indeed", "label": "Indeed Job Application Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_workday", "label": "Workday ATS Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typeahead prompt fields are the #1 cause of stuck runs. Correct procedure: short query \u2192 read_page (dropdown options appear at top with refs) \u2192 left_click the ref. Budget 4 turns per field. Never use javascript_tool to set field values; Workday ignores it. Never press Enter in typeahead fields."}, {"id": "domain_skill_greenhouse", "label": "Greenhouse ATS Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_lever", "label": "Lever ATS Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_ashby", "label": "Ashby ATS Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_smartrecruiters", "label": "SmartRecruiters ATS Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_tesla", "label": "Tesla Careers Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tesla uses TDS (Tesla Design System) custom dropdowns with aria-haspopup='listbox'. Phone field has TWO elements (country code button + text input). Legal acknowledgment on Step 3 requires a required checkbox. Login may interrupt and require re-navigating to job URL."}, {"id": "domain_skill_xcom", "label": "X/Twitter Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "X uses Draft.js editors where form_input silently fails and computer type garbles text. Only reliable method is javascript_tool with execCommand('insertText'). Page loads asynchronously \u2014 read_page returns only keyboard shortcut text for 3-5 seconds; use get_page_text instead and never re-navigate to same URL."}, {"id": "domain_skill_gcalendar", "label": "Google Calendar Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_gdrive", "label": "Google Drive Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_notion", "label": "Notion Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_figma", "label": "Figma Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_slack", "label": "Slack Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "domain_skill_amazon", "label": "Amazon Domain Skill", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "antibot_pattern", "label": "Anti-Bot Site Pattern", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some domains (reddit.com, linkedin.com, twitter.com, x.com, tesla.com) are flagged with antiBot:true, indicating enhanced protection that may require extra care with timing, navigation patterns, and avoiding automation detection signals."}, {"id": "token_efficiency_pattern", "label": "Token Efficiency Pattern for ATS Forms", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistent pattern across ATS skills: use get_page_text for job descriptions, read_page only for form interaction with max_chars=20000. Never request 60000-80000 max_chars on listing pages \u2014 inflates cost without revealing more content."}, {"id": "file_upload_shadow_dom", "label": "Shadow DOM File Upload Pattern", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ATS resume upload fields are often inside shadow DOM. Correct approach: use file_upload tool with numeric ref from read_page (resolves backendNodeIds and pierces shadow DOM). Never click 'My Computer' and type into OS dialog \u2014 agent cannot see OS dialogs."}, {"id": "tabs_context_pattern", "label": "tabs_context After ATS Navigation Pattern", "file_type": "rationale", "source_file": "server/src/agent/domain-skills.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After clicking Apply on job aggregators (SimplifyJobs, JobRight), immediately call tabs_context to determine if ATS opened in same tab or new tab. Skipping this check leads to duplicate tab creation or missed tab switches."}], "edges": [{"source": "domain_skills_json", "target": "domain_skill_gmail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/src/agent/domain-skills.json", "source_location": null, "weight": 1.0}, {"source": "domain_skills_json", "target": "domain_skill_gdocs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/src/agent/domain-skills.json", "source_location": null, "weight": 1.0}, {"source": "domain_skills_json", "target": "domain_skill_gsheets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/src/agent/domain-skills.json", "source_location": null, "weight": 1.0}, {"source": "domain_skills_json", "target": "domain_skill_github", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/src/agent/domain-skills.json", "source_location": null, "weight": 1.0}, {"source": "domain_skills_json", "target": "domain_skill_simplifyjobs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/src/agent/domain-skills.json", "source_location": null, "weight": 1.0}, {"source": "domain_skills_json", "target": "domain_skill_reddit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/src/agent/domain-skills.json", "source_location": null, "weight": 1.0}, {"source": "domain_skills_json", "target": "domain_skill_jobright", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "server/src/agent/domain-skills.json", "source_location": null, "weight": 1.0}, {"source": "d